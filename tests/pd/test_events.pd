#N canvas 0 50 700 500 10;
#X obj 10 10 loadbang;
#X obj 300 10 r ch;
#X obj 420 10 r oh;
#X obj 540 10 r cmd;
#X obj 300 100 trxch~;
#X obj 420 100 trxoh~;
#X obj 300 150 print CH;
#X obj 450 150 print OH;
#X obj 420 200 writesf~ 1;
#X obj 420 230 dac~;
#X obj 10 50 delay 0;
#X msg 10 70  \;  pd dsp 1 \;  cmd open -bytes 4 /tmp/oh_test.wav \;  cmd start;
#X obj 10 90 delay 50;
#X msg 10 110  \;  oh bang;
#X obj 10 130 delay 400;
#X msg 10 150  \;  ch bang;
#X obj 10 170 delay 900;
#X msg 10 190  \;  oh bang;
#X obj 10 210 delay 1000;
#X msg 10 230  \;  oh dump \;  oh get dec \;  oh store 2 \;  oh dec 10 \;  oh dump \;  oh recall 2 \;  oh dump \;  ch dump \;  oh dump 2 \;  oh dump 7;
#X obj 10 250 delay 1100;
#X msg 10 270  \;  oh dump trxch 1 2 3 4 5 \;  oh dump trxoh 7 8 9 10 11 \;  oh dump \;  oh foo \;  oh dec abc \;  oh ctl 9 1;
#X obj 10 290 delay 1200;
#X msg 10 310  \;  oh print \;  oh 200 \;  oh choke \;  oh chokems 20 \;  oh bang \;  oh level 0.5;
#X obj 10 330 delay 2500;
#X msg 10 350  \;  cmd stop;
#X obj 10 370 delay 2600;
#X msg 10 390  \;  pd quit;
